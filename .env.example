# ==============================================================================
# RESCUEPLATE ENVIRONMENT CONFIGURATION
# ==============================================================================
# In hackathon evaluation mode, the application runs fully functional in Demo Mode
# without requiring external Supabase credentials. All actions persist in localStorage.
#
# To connect to production Supabase:
# 1. Create a Supabase project at https://supabase.com
# 2. Run migrations from supabase/migrations/
# 3. Supply your project keys below and rename this file to .env
# ==============================================================================

VITE_APP_NAME=RescuePlate
VITE_APP_TAGLINE="Every Meal Matters"

# Optional Production Supabase Settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Platform Configuration
VITE_ENABLE_DEMO_BAR=true
VITE_MAP_DEFAULT_LAT=37.7749
VITE_MAP_DEFAULT_LNG=-122.4194

